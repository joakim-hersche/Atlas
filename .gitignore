# Data: raw and interim downloads are cached locally, never committed
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
web/dist/

# OS / editor
.DS_Store
*.swp

# Generated web data (rebuilt by make; deployment builds them in CI)
data/out/web/
data/out/reach/
web/public/data/
